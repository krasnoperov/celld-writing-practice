# celld exposes CELLD_VAR_* values to the worker without the prefix.
CELLD_VAR_COACH_PROVIDER=demo
CELLD_VAR_OPENAI_MODEL=gpt-5.6-sol
# CELLD_VAR_OPENAI_API_KEY=
# CELLD_VAR_OPENAI_BASE_URL=https://api.openai.com/v1

CELLD_VAR_BASE_PATH=/
CELLD_VAR_PUBLIC_BASE_URL=http://localhost:8931
CELLD_VAR_GITHUB_CALLBACK_URL=http://localhost:8931/auth/github/callback
CELLD_VAR_GITHUB_APP_CLIENT_ID=
CELLD_VAR_GITHUB_APP_CLIENT_SECRET=
CELLD_VAR_SESSION_SECRET=

CELLD_VAR_ADMIN_GITHUB_IDS=
CELLD_VAR_MONTHLY_AGENT_RUNS=50
CELLD_VAR_PLAN_NAME="Writing Practice monthly"
CELLD_VAR_POLAR_ACCESS_TOKEN=
CELLD_VAR_POLAR_PRODUCT_ID=
CELLD_VAR_POLAR_WEBHOOK_SECRET=
# CELLD_VAR_POLAR_API_BASE=https://api.polar.sh/v1

# Credentials for the S3-compatible bucket used by the celld process.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
